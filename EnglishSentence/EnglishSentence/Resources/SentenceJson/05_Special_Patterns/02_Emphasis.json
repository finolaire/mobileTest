{
  "unit_name": "特殊句型 (2/3) - 强调句",
  "description": "使用 'It is/was ... that/who ...' 结构来强调句子中的某个成分（通常是主语、宾语或状语）。",
  "category": "Special_Patterns",
  "code": "PATTERN_EMPHASIS",
  "sentences": [
    {
      "id": "PATTERN_EMPHASIS_001",
      "sentence_info": {
        "original": "It was yesterday that I met him",
        "translation": "我是在昨天遇见他的",
        "sentence_pattern": "It was + 被强调部分(时间状语) + that + 剩余部分",
        "pattern_code": "IT_BE_ADV_THAT",
        "difficulty_level": 2,
        "tags": ["special_pattern", "emphasis", "time_emphasis"]
      },
      "analysis": [
        {
          "word": "It was",
          "base_form": "it be",
          "range": [0, 6],
          "tag": "phrase_emphasis_head",
          "type": "Emphasis Structure (强调句型)",
          "chinese_definition": "正是...",
          "explanation": "强调句的开头结构，因为 met 是过去式，所以用 was。",
          "phonetics": {
            "uk": "/ɪt wɒz/", "us": "/ɪt wɑːz/"
          }
        },
        {
          "word": "yesterday",
          "base_form": "yesterday",
          "range": [7, 16],
          "tag": "adverb_time",
          "type": "Emphasized Part (被强调部分)",
          "chinese_definition": "昨天",
          "explanation": "被强调的时间状语。",
          "phonetics": {
            "uk": "/ˈjestədeɪ/", "us": "/ˈjestərdeɪ/"
          }
        },
        {
          "word": "that",
          "base_form": "that",
          "range": [17, 21],
          "tag": "conjunction_emphasis",
          "type": "Emphasis Connector (连接词)",
          "chinese_definition": "（无实义）",
          "explanation": "强调句的连接词。",
          "phonetics": {
            "uk": "/ðæt/", "us": "/ðæt/"
          }
        },
        {
          "word": "I met him",
          "base_form": "I met him",
          "range": [22, 31],
          "tag": "clause_remaining",
          "type": "Remaining Part (剩余部分)",
          "chinese_definition": "我遇见他",
          "explanation": "句子的其余部分。",
          "phonetics": {
            "uk": "", "us": ""
          }
        }
      ]
    },
